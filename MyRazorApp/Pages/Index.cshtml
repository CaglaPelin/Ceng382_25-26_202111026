@* GPT Prompts:
 JSON dışa aktarma (export) özelliği eklenmek isteniyor; sadece o sayfadaki veriler indirilsin. Bu nasıl yapılır?
 Kullanıcının tablo kolon başlıklarına tıklayarak kolonları seçmesi ve sadece seçilen kolonları JSON olarak dışa aktarması nasıl sağlanır?
Json formatında verileri boş döndürüyor. Bunu nasıl düzeltebilirim?


*@
@page
@model IndexModel

<div class="container py-5">
    <h2 class="display-5 fw-bold text-center mb-4 text-primary">📊 Class Management Dashboard</h2>

    <div class="row g-5">
        <!-- 📝 FORM -->
        <div class="col-lg-4" style="margin-top: 145px;">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-gradient bg-primary text-white text-center fs-5 rounded-top-4 fw-semibold">
                    @(Model.EditId == 0 ? "➕ Add Class" : "🔄 Update Class")
                </div>
                <div class="card-body bg-light">
                    <form method="post" asp-page-handler="@(Model.EditId == 0 ? "Add" : "Update")">
                        <input type="hidden" asp-for="EditId" />
                        <div class="mb-3">
                            <label class="form-label">📖 Class Name</label>
                            <input asp-for="NewClass.ClassName" class="form-control rounded-pill shadow-sm" required />
                            <span asp-validation-for="NewClass.ClassName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">👥 Number of Students</label>
                            <input asp-for="NewClass.StudentCount" type="number" class="form-control rounded-pill shadow-sm" required />
                            <span asp-validation-for="NewClass.StudentCount" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">📝 Description</label>
                            <textarea asp-for="NewClass.Description" class="form-control rounded-4 shadow-sm" rows="3" required></textarea>
                            <span asp-validation-for="NewClass.Description" class="text-danger small"></span>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary rounded-pill shadow">
                                @(Model.EditId == 0 ? "➕ Add Class" : "✔️ Update Class")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- 📋 TABLO -->
        <div class="col-lg-8">
            <h5 class="text-center text-secondary">🔎 Filter by Class Name</h5>
            <form method="get" class="mb-4 d-flex justify-content-center">
                <div class="input-group w-75 shadow-sm">
                    <input name="FilterText" value="@Model.FilterText" class="form-control" placeholder="Type to search..." />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>

            <!-- Tablo -->
            <div class="table-responsive shadow rounded-4 border border-2 border-light">
                <table class="table table-hover align-middle text-center mb-0" id="dataTable">
                    <thead class="table-primary text-dark">
                        <tr>
                            <th class="selectable" data-col="ClassName" style="cursor: pointer;">
                                📚 Class Name
                            </th>
                            <th class="selectable" data-col="StudentCount" style="cursor: pointer;">
                                🎓 Students
                            </th>
                            <th class="selectable" data-col="Description" style="cursor: pointer;">
                                📝 Description
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        @foreach (var item in Model.FilteredClasses)
                        {
                            <tr>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <!-- Edit Butonu -->
                                    <form method="post" asp-page-handler="LoadEdit" asp-route-id="@item.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">✏️ Edit</button>
                                    </form>
                                    <!-- Delete Butonu -->
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            
            <div class="d-flex justify-content-end gap-3 mb-3">
        <!-- Export Selected Columns -->
        <form method="post" asp-page-handler="ExportSelectedJson" id="exportForm">
            <input type="hidden" id="SelectedColumns" name="SelectedColumns" />
            <button type="submit" class="btn btn-outline-success rounded-pill shadow-sm" id="exportButton">
                📤 Export Columns as JSON
            </button>
        </form>

        <!-- Export Current Page -->
        <a asp-page-handler="DownloadJson"
        asp-route-currentPage="@Model.CurrentPage"
        asp-route-filter="@Model.FilterText"
        class="btn btn-outline-primary rounded-pill shadow-sm">
            📥 Export Current Page as JSON
        </a>
    </div>


            <!-- Sayfalama -->
            <div class="mt-4 text-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a class="btn btn-sm @(Model.CurrentPage == i ? "btn-primary" : "btn-outline-secondary") m-1 shadow-sm rounded-pill"
                       href="?CurrentPage=@i&FilterText=@Model.FilterText">@i</a>
                }
            </div>
        </div>
    </div>
</div>


<a href="/Logout" class="btn btn-danger rounded-pill shadow-sm">🚪 Logout</a>


@section Scripts {
    <script>
        const selectedColumns = new Set();
        const exportButton = document.getElementById('exportButton');

        document.querySelectorAll('.selectable').forEach(header => {
            header.addEventListener('click', function() {
                const column = this.dataset.col;
                
                if (selectedColumns.has(column)) {
                    selectedColumns.delete(column);
                    this.classList.remove('table-warning');
                } else {
                    selectedColumns.add(column);
                    this.classList.add('table-warning');
                }

              
                document.getElementById('SelectedColumns').value = Array.from(selectedColumns).join(',');
            });
        });
    </script>
}


