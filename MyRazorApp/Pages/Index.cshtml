@*
GPT Prompt:
Design a visually appealing and user-friendly Razor Pages frontend using Bootstrap 5.
The page layout should include a two-column structure:
- Left: A responsive card that contains a form for adding or updating class information (Class Name, Student Count, Description).
- Right: A table displaying filtered results with Edit and Delete buttons, along with pagination buttons (1, 2, 3...) below.
The form's title and button text should dynamically change between "Add Class" and "Update Class".
Include a top margin so the form doesn’t appear too close to the page header. Use soft shadows, rounded corners, and consistent spacing for aesthetics.
*@




@page
@model IndexModel

<div class="container py-5">
    <h2 class="display-5 fw-bold text-center mb-4 text-primary">📊 Class Management Dashboard</h2>

    <div class="row g-5">
        <!-- 📝 FORM -->
        <div class="col-lg-4" style="margin-top: 145px;">

            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-gradient bg-primary text-white text-center fs-5 rounded-top-4 fw-semibold">
                    @(Model.EditId == 0 ? "➕ Add Class" : "🔄 Update Class")
                </div>
                <div class="card-body bg-light">
                    <form method="post">
                        <input type="hidden" asp-for="EditId" />
                        <div class="mb-3">
                            <label class="form-label">📖 Class Name</label>
                            <input asp-for="NewClass.ClassName" class="form-control rounded-pill shadow-sm" />
                            <span asp-validation-for="NewClass.ClassName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">👥 Number of Students</label>
                            <input asp-for="NewClass.StudentCount" type="number" class="form-control rounded-pill shadow-sm" />
                            <span asp-validation-for="NewClass.StudentCount" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">📝 Description</label>
                            <textarea asp-for="NewClass.Description" class="form-control rounded-4 shadow-sm" rows="3"></textarea>
                            <span asp-validation-for="NewClass.Description" class="text-danger small"></span>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" asp-page-handler="Submit" class="btn @(Model.EditId == 0 ? "btn-primary" : "btn-warning text-dark") rounded-pill shadow">
                                @(Model.EditId == 0 ? "➕ Add Class" : "✔️ Update Class")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- 📋 TABLO -->
        <div class="col-lg-8">
          
<h5 class="text-center text-secondary">🔎 Filter by Class Name</h5>
<form method="get" class="mb-4 d-flex justify-content-center">
    <div class="input-group w-75 shadow-sm">
        <input name="FilterText" value="@Model.FilterText" class="form-control" placeholder="Type to search..." />
        <button type="submit" class="btn btn-outline-primary">Filter</button>
    </div>
</form>

<!-- 🪄 Tablo -->
<div class="mt-3 table-responsive shadow rounded-4 border border-2 border-light">
    <table class="table table-hover align-middle text-center mb-0">
        <thead class="table-primary text-dark">
            <tr>
                <th>📚 Class Name</th>
                <th>🎓 Students</th>
                <th class="text-start">📝 Description</th>
                <th>⚙️ Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white">
            @if (Model.FilteredClasses.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted py-4">No data found.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.FilteredClasses)
                {
                    <tr>
                        <td class="fw-semibold">@item.ClassName</td>
                        <td>@item.StudentCount</td>
                        <td class="text-start">@item.Description</td>
                        <td>
                            <form method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button asp-page-handler="LoadEdit" class="btn btn-sm btn-warning text-dark rounded-pill shadow-sm">✏️ Edit</button>
                            </form>
                            <form method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button asp-page-handler="Delete" class="btn btn-sm btn-danger rounded-pill shadow-sm">🗑️ Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<!--  Sayfalama -->
<div class="mt-4 text-center">
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a class="btn btn-sm @(Model.CurrentPage == i ? "btn-primary" : "btn-outline-secondary") m-1 shadow-sm rounded-pill"
           href="?CurrentPage=@i&FilterText=@Model.FilterText">@i</a>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
